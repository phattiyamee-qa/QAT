# Copy this file to .env.local and fill in real values. Never commit .env.local
# (already covered by .gitignore).

# --- Supabase Postgres (Settings -> Database -> Connection string) ---
# Pooled connection (pgbouncer), used by the app at runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[POOLER_HOST]:6543/postgres?pgbouncer=true"
# Direct connection, used only by Prisma Migrate (bypasses the pooler).
DIRECT_URL="postgresql://postgres:[PASSWORD]@[DB_HOST]:5432/postgres"

# --- Supabase project (Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_PUBLIC_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]" # server-only, never exposed to the client

# --- Apps Script -> /api/sync webhook ---
SYNC_WEBHOOK_SECRET="[SHARED_SECRET]" # generate a random string, set the same value in the Apps Script project properties
