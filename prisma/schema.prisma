// Supabase project yet. Claude Code should review this against build-sequence
// step 2 before running any migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CreatedFrom {
  sheet
  site
}

enum Phase {
  UAT
  LIVE
}

enum FieldSource {
  sheet
  site_override
}

enum ProjectRole {
  QA
  PM
}

enum UserRole {
  QA
  PM
  MANAGER
  ADMIN
}

enum OverrideStatus {
  UAT
  LIVE
  DONE
  SKIPPED
}

model Project {
  id           String      @id @default(cuid())
  title        String // bracket-stripped at sync time
  category     String // sheet tab name, e.g. "Payment", "Platform"
  priority     String? // P0-P3
  remark       String?
  createdFrom  CreatedFrom @default(sheet) @map("created_from")
  sheetRowRef  String?     @map("sheet_row_ref") // stable id, e.g. "Payment:row42"

  periods         Period[]
  assignments     Assignment[]
  statusOverride  StatusOverride?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([sheetRowRef])
  @@map("project")
}

model Period {
  id        String      @id @default(cuid())
  projectId String      @map("project_id")
  project   Project     @relation(fields: [projectId], references: [id])
  phase     Phase
  startDate DateTime?   @map("start_date")
  endDate   DateTime?   @map("end_date")
  source    FieldSource @default(sheet)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([projectId, phase]) // one UAT + one LIVE period per project
  @@map("period")
}

model Assignment {
  projectId    String      @map("project_id")
  project      Project     @relation(fields: [projectId], references: [id])
  personId     String      @map("person_id")
  person       Person      @relation(fields: [personId], references: [id])
  roleOnProject ProjectRole @map("role_on_project")

  @@id([projectId, personId, roleOnProject])
  @@map("assignment")
}

model Person {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  googleSub String?  @unique @map("google_sub")

  assignments Assignment[]
  roles       Role[]

  @@map("person")
}

model Role {
  personId String   @map("person_id")
  person   Person   @relation(fields: [personId], references: [id])
  role     UserRole

  @@id([personId, role])
  @@map("role")
}

model StatusOverride {
  projectId String         @id @map("project_id")
  project   Project        @relation(fields: [projectId], references: [id])
  status    OverrideStatus
  setBy     String?        @map("set_by")
  setAt     DateTime       @default(now()) @map("set_at")

  @@map("status_override")
}
